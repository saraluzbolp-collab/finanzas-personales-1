rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'monthlyBudget',
          'hasConfiguredBudget',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'monthlyBudget',
          'hasConfiguredBudget',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (data.monthlyBudget is int || data.monthlyBudget is float)
        && data.monthlyBudget >= 0
        && data.monthlyBudget <= 1000000000000
        && data.hasConfiguredBudget is bool
        && (!data.hasConfiguredBudget || data.monthlyBudget > 0)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMovement(data, userId) {
      return data.keys().hasAll([
          'uid',
          'amount',
          'category',
          'date',
          'description',
          'type',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'amount',
          'category',
          'date',
          'description',
          'type',
          'paymentMethod',
          'observations',
          'createdAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid == request.auth.uid
        && data.uid == userId
        && (data.amount is int || data.amount is float)
        && data.amount > 0
        && data.amount <= 1000000000000
        && data.category is string
        && data.category.size() >= 1 && data.category.size() <= 60
        && data.date is string
        && data.date.size() >= 1 && data.date.size() <= 40
        && data.description is string
        && data.description.size() >= 1 && data.description.size() <= 200
        && data.type in ['expense', 'income']
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 60))
        && (!('observations' in data) || (data.observations is string && data.observations.size() <= 500))
        && data.createdAt is timestamp;
    }

    // 4. User Profile Rules (Private PII & Budget Settings)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['monthlyBudget', 'hasConfiguredBudget', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'monthlyBudget', 'hasConfiguredBudget', 'updatedAt'])
        );

      allow delete: if false;

      // 5. User Movements Subcollection (Private Expenses & Income)
      match /movements/{movementId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(movementId)
          && existing().uid == request.auth.uid;

        allow list: if isOwner(userId)
          && resource.data.uid == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(movementId)
          && isValidMovement(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(movementId)
          && isValidMovement(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'category', 'date', 'description', 'paymentMethod', 'observations'])
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(movementId)
          && existing().uid == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}
